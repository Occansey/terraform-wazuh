# Copy this file to terraform.tfvars and fill in the values

# AWS Region
aws_region = "us-east-1"

# Name of your SSH key pair in AWS (without .pem extension)
key_name = "your-key-name"

# Wazuh Dashboard admin password
wazuh_admin_password = "YourSecurePassword123!"

# VirusTotal API key (get free key at https://www.virustotal.com)
virustotal_api_key = "your-virustotal-api-key"

# Your IP address for SSH access (leave empty to auto-detect)
# Format: "x.x.x.x/32"
allowed_ssh_cidr = ""

# Instance types (adjust based on your needs)
wazuh_server_instance_type = "t3.large"
agent_instance_type        = "t3.small"
